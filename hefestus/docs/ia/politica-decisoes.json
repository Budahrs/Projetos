  "activation": {
    "trigger": "Pedido de construir programa usando Hefestus/Bíblia/GDD no contexto Hefestus",
    "requires_reader": true,
    "automatic_global_memory": false,
    "offline_requires_files": true
  },
  "modes": {
    "integrated": "Usar ferramentas reais disponíveis e compatíveis.",
    "architectural": "Sem instalação, aplicar contratos/práticas via ferramentas disponíveis e declarar modo.",
    "partial": "Registrar lacunas e continuar trabalho independente."
  },
  "rules": [
    {
      "id": "POL-001",
      "rule": "Consultar código/contratos reais e decisões antes de construir.",
      "bible_sections": [
        2,
        26
      ]
    },
    {
      "id": "POL-002",
      "rule": "Preservar formatos/proteções, dados e mudanças do usuário.",
      "bible_sections": [
        6,
        11
      ]
    },
    {
      "id": "POL-003",
      "rule": "Primeiro fluxo vertical completo antes da expansão.",
      "bible_sections": [
        17,
        22
      ]
    },
    {
      "id": "POL-004",
      "rule": "Uma linguagem suficiente; outras por contrato/necessidade.",
      "bible_sections": [
        5,
        8
      ]
    },
    {
      "id": "POL-005",
      "rule": "Núcleo mínimo e API pública antes de aplicativo inteiro.",
      "bible_sections": [
        9
      ]
    },
    {
      "id": "POL-006",
      "rule": "Metadados separados, carga opcional, dependências fixadas.",
      "bible_sections": [
        9,
        23
      ]
    },
    {
      "id": "POL-007",
      "rule": "Score heurístico ordena avaliações; portões decidem elegibilidade.",
      "bible_sections": [
        13,
        25
      ]
    },
    {
      "id": "POL-008",
      "rule": "Sem resultado medido, não afirmar ganho de performance.",
      "bible_sections": [
        13,
        25
      ]
    },
    {
      "id": "POL-009",
      "rule": "Mesmo caso de uso para UI/CLI/MCP quando aplicável.",
      "bible_sections": [
        10,
        11
      ]
    },
    {
      "id": "POL-010",
      "rule": "Validar cedo sem substituir teste do artefato.",
      "bible_sections": [
        13,
        22
      ]
    },
    {
      "id": "POL-011",
      "rule": "Salvar não dispara compilação integral.",
      "bible_sections": [
        6,
        22
      ]
    },
    {
      "id": "POL-012",
      "rule": "Distinguir código/planejamento de teste/homologação.",
      "bible_sections": [
        2,
        24
      ]
    },
    {
      "id": "POL-013",
      "rule": "Sem editor instalado, não fingir CLI/MCP ou formato nativo validado.",
      "bible_sections": [
        28
      ]
    },
    {
      "id": "POL-014",
      "rule": "Instalador final separado de preparação/desenvolvimento.",
      "bible_sections": [
        12,
        22
      ]
    },
    {
      "id": "POL-015",
      "rule": "Não relaxar aceite para declarar sucesso; verificar escopo e retorno.",
      "bible_sections": [
        25,
        26
      ]
    },
    {
      "id": "POL-016",
      "rule": "Histórico registra revisão, fontes, mudança, evidências e limite.",
      "bible_sections": [
        26,
        29
      ]
    },
    {
      "id": "POL-017",
      "rule": "Distinguir aplicação, marcação, estilo, SQL e automação; escolher perfil/destino antes de comparar.",
      "bible_sections": [
        30
      ]
    }
  ],
