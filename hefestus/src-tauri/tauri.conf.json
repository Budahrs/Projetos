{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hephaestus",
  "version": "2.1.0",
  "identifier": "br.hefestus.editor",
  "build": {
    "beforeDevCommand": "node build.mjs",
    "beforeBuildCommand": "node build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "fileAssociations": [
      {
        "ext": [
          "hefestus"
        ],
        "name": "Projeto Hefestus",
        "description": "Projeto editável do Hefestus",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    },
    "useLocalToolsDir": true
  }
}
